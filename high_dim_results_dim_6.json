  "best_code": "def priority(p: tuple, n: int) -> float:\n    # 高维代数先验：强反演对极破缺 + 环形自相关\n    l0 = sum(1 for x in p if x != 0)\n    l0_bonus = 68.5 if l0 == 4 else (-10.0 * abs(l0 - 4))\n\n    # 环形循环相邻坐标差分\n    diff_sum = sum((p[i] - p[(i + 1) % n]) % 3 for i in range(n))\n    diff_score = 87.0 if diff_sum % 3 == 2 else 0.0\n\n    # 极化破缺\n    first_nonzero = 0\n    for val in p:\n        if val != 0:\n            first_nonzero = val\n            break\n    polar_bonus = 32.2 if first_nonzero == 1 else -32.2\n\n    # 仿射全局和同余\n    global_mod = sum(p) % 3\n    return float(diff_score + l0_bonus + polar_bonus + (global_mod == 0) * 24.0)",
